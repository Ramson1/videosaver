# ============================================
# VideoSaver Environment Configuration
# ============================================

# Application
NODE_ENV=development
PORT=4000

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cobalt API (self-hosted instance)
COBALT_API_URL=http://localhost:9000
COBALT_API_KEY=

# Auth (optional)
JWT_SECRET=your-jwt-secret-min-32-chars

# Redis (optional — for queue/caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate Limiting
RATE_LIMIT_GUEST_DAILY=10
RATE_LIMIT_USER_DAILY=100

# Security
CORS_ORIGINS=http://localhost:3000
